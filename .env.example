# Private Web access — server side only
FRAGMENTHUB_PASSWORD=
FRAGMENTHUB_SESSION_SECRET=

# GitHub Remote Store — server side only
# Fine-grained token must have Contents: Read and write on EstherAIRP/FragmentHub.
FRAGMENTHUB_GITHUB_TOKEN=

# Optional: these defaults are already used by the application.
FRAGMENTHUB_GITHUB_REPOSITORY=EstherAIRP/FragmentHub
FRAGMENTHUB_GITHUB_BRANCH=main
