# OpenAI — used by the GPT analysis layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Keep production AI analysis disabled until authentication exists.
FRAGMENTHUB_ALLOW_PRODUCTION_ANALYSIS=false

# GitHub Remote Store — server side only
# Fine-grained token / GitHub App token must have Repository Contents read/write.
FRAGMENTHUB_GITHUB_TOKEN=
FRAGMENTHUB_GITHUB_REPOSITORY=EstherAIRP/FragmentHub
FRAGMENTHUB_GITHUB_BRANCH=main
